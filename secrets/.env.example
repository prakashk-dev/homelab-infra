# Copy to secrets/.env and fill in. secrets/.env is gitignored — never committed.
# Load before running kubectl/terraform:   set -a; . secrets/.env; set +a

# ---- Cloudflare ----
CLOUDFLARE_API_TOKEN=paste-scoped-dns-edit-token

# Terraform reads TF_VAR_* automatically (same token reused)
TF_VAR_cloudflare_api_token=${CLOUDFLARE_API_TOKEN}
TF_VAR_cloudflare_account_id=paste-account-id
TF_VAR_cloudflare_zone_id=paste-zone-id
TF_VAR_domain=pkandel.com
TF_VAR_tunnel_secret=paste-output-of-`openssl rand -base64 32`

# ---- Filled in AFTER `terraform apply` (it is a terraform output) ----
TUNNEL_TOKEN=
